# Database
POSTGRES_DB=inventory_db
POSTGRES_USER=inventory_user
POSTGRES_PASSWORD=change-me

# Backend
DATABASE_URL=postgresql+asyncpg://inventory_user:change-me@localhost:5432/inventory_db
SECRET_KEY=generate-a-random-string-min-32-chars
ENVIRONMENT=development

# JWT Settings
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Alert Thresholds (days before expiration)
ALERT_THRESHOLD_120=120
ALERT_THRESHOLD_90=90
ALERT_THRESHOLD_60=60
ALERT_THRESHOLD_30=30

# Dead Stock Threshold (days without movement)
DEAD_STOCK_DAYS=180

# Seed users (only used on first run when DB has no users)
ADMIN_SEED_PASSWORD=change-me
USER_SEED_PASSWORD=change-me

# Email (Resend - required for alert emails, delivery notes, and the
# "Send Test Email" button in Settings to work)
RESEND_API_KEY=
EMAIL_FROM=Lino Inventory <onboarding@resend.dev>


